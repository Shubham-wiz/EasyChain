# Text files are stored with LF and checked out with LF on every system, Windows included.
# Shell scripts then run under bash, and golden files and lock files match byte for byte.
* text=auto eol=lf

# Windows scripts keep Windows line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.db binary
*.zip binary
*.pdf binary
*.docx binary
