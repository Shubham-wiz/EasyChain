{
  "name": "easychain-monorepo",
  "private": true,
  "description": "Easy Chain: draw your AI app, press Run, watch it think, ship it with one click.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/tasks.mjs install",
    "dev": "node scripts/tasks.mjs dev",
    "build": "node scripts/tasks.mjs build",
    "server": "node scripts/tasks.mjs server",
    "worker": "node scripts/tasks.mjs worker",
    "test": "node scripts/tasks.mjs test",
    "e2e": "node scripts/tasks.mjs e2e",
    "lint": "node scripts/tasks.mjs lint",
    "format": "node scripts/tasks.mjs format",
    "schema": "node scripts/tasks.mjs schema",
    "golden": "node scripts/tasks.mjs golden",
    "docker": "node scripts/tasks.mjs docker",
    "clean": "node scripts/tasks.mjs clean",
    "typecheck": "pnpm --filter @easychain/web typecheck && pnpm --filter @easychain/client typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
